# ==========================================================================
# WARRANTY WALLET -- FRONTEND LOCAL-ONLY ENVIRONMENT TEMPLATE
# ==========================================================================
# Copy this file to frontend/.env.local and replace placeholders with your own
# values. Vite loads .env.local automatically during development and build.
#
# Variables prefixed with VITE_ are exposed to browser JavaScript. Do not put
# backend secrets in frontend variables.
# ==========================================================================

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Google OAuth Web client ID (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=you will have.