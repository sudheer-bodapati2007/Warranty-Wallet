# ==============================================================================
# WARRANTY WALLET — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your own credentials.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated allowed frontend origins for CORS (e.g. https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas Connection URI)
MONGODB_URI=you will have.

# JWT Authentication
JWT_SECRET=your_strong_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d

# Google OAuth (OpenID Connect)
# Create an OAuth 2.0 Web client in Google Cloud Console and add your frontend
# origins and backend callback URLs.
GOOGLE_CLIENT_ID=you will have.
# S3 / Cloudflare R2 Cloud Storage (Optional for local fallback; required in production)
# For Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
S3_BUCKET=warranty-wallet-uploads
S3_ACCESS_KEY_ID=your_storage_access_key_id
S3_SECRET_ACCESS_KEY=your_storage_secret_access_key
S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Warranty Wallet <notifications@yourverifieddomain.com>

# Scheduled Reminders & Cron Authorization
CRON_SECRET=your_secure_cron_webhook_secret_here

# Optional Image Search Provider (Wikimedia is used by default without credentials)
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Cloudinary Image Storage (used for profile photos and product images in production)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_UPLOAD_FOLDER=warranty-wallet
