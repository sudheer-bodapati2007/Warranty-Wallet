# ==========================================================================
# WARRANTY WALLET -- BACKEND LOCAL-ONLY ENVIRONMENT TEMPLATE
# ==========================================================================
# Copy this file to backend/.env.local and replace placeholders with values
# from your own deployment dashboards. Never commit real secret files.
#
# backend/.env.local loads before backend/.env. Values already defined by the
# shell are not overwritten by dotenv.
# ==========================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins allowed by CORS.
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas URI, secret)
MONGODB_URI=you will have.

# JWT Authentication (secret)
JWT_SECRET=your_strong_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d

# Google OAuth
# Use the same Web client ID in frontend and backend.
GOOGLE_CLIENT_ID=you will have.
# S3 / Cloudflare R2 Cloud Storage (Optional local fallback; required in production)
S3_BUCKET=warranty-wallet-uploads
S3_ACCESS_KEY_ID=your_storage_access_key_id
S3_SECRET_ACCESS_KEY=your_storage_secret_access_key
S3_REGION=us-east-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Warranty Wallet <notifications@yourverifieddomain.com>

# Scheduled Reminders & Cron Authorization
CRON_SECRET=your_secure_cron_webhook_secret_here

# Optional Image Search Provider (Wikimedia is used by default)
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Cloudinary Image Storage (profile photos and product images)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_UPLOAD_FOLDER=warranty-wallet